# ============================================================
# EventPulse V2.1 — Backend configuration
# This is the DEV template. Copy to .env and fill real values.
# NEVER commit real secrets.
# ============================================================

# --- Node/Nest ---
NODE_ENV=development
PORT=3000
APP_NAME=eventpulse-backend

# --- PostgreSQL (TypeORM) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eventpulse
POSTGRES_PASSWORD=eventpulse_dev
POSTGRES_DB=eventpulse

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0            # hot reservation counters / caches
REDIS_SAGA_DB=1       # outbox + idempotency tracking

# --- Event Bus ---
EVENT_BUS_PROVIDER=redis     # redis (default) | kafka (see infra/README)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=eventpulse

# --- OpenTelemetry / health ---
OTEL_EXPORTER_OTLP_ENDPOINT=
HEALTHCHECK_TIMEOUT_MS=5000

# --- Security (MVP: API key + role). MFA-gated in prod. ---
OVERRIDE_API_KEY=change-me-in-prod
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=8h

# --- AI concierge (NVIDIA NIM — OpenAI-compatible chat completions) ---
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Get a key at https://integrate.api.nvidia.com — NEVER commit it.
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AI_TIMEOUT_MS=40000
